<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.bankingandloanmanagementsystem.mapper.AdminMapper">

    <resultMap id="AdminResultMap" type="com.crimsonlogic.bankingandloanmanagementsystem.model.implementations.userimplementations.Admin">
        <id property="adminId" column="admin_id"/>
        <result property="name" column="name"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="email" column="email"/>
        <result property="address" column="address"/>
        <result property="password" column="password"/>
        <result property="dateOfBirth" column="date_of_birth"/>
        <result property="bankName" column="bank_name"/>
        <result property="status" column="status"/>
        <result property="role" column="role"/>
        <result property="salary" column="salary"/>
        <result property="branchId" column="branch_id"/>
    </resultMap>

    <insert id="insertAdmin" parameterType="com.crimsonlogic.bankingandloanmanagementsystem.model.implementations.userimplementations.Admin">
        INSERT INTO admins (admin_id, name, phone_number, email, address, password, date_of_birth, bank_name, status, role, salary, branch_id)
        VALUES (#{adminId}, #{name}, #{phoneNumber}, #{email}, #{address}, #{password}, #{dateOfBirth}, #{bankName}, #{status}, #{role}, #{salary}, #{branchId})
    </insert>

    <select id="getAdminByEmail" resultMap="AdminResultMap">
        SELECT * FROM admins WHERE email = #{email}
    </select>

    <select id="getAdminById" resultMap="AdminResultMap">
        SELECT * FROM admins WHERE admin_id = #{adminId}
    </select>

    <select id="getAllAdmins" resultMap="AdminResultMap">
        SELECT * FROM admins
    </select>

    <update id="updateAdminStatus">
        UPDATE admins SET status = #{status} WHERE admin_id = #{adminId}
    </update>

</mapper>