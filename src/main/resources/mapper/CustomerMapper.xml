<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.bankingandloanmanagementsystem.mapper.CustomerMapper">

    <resultMap id="CustomerResultMap" type="com.crimsonlogic.bankingandloanmanagementsystem.model.implementations.userimplementations.Customer">
        <id property="customerId" column="customer_id"/>
        <result property="name" column="name"/>
        <result property="phoneNumber" column="phone_number"/>
        <result property="email" column="email"/>
        <result property="address" column="address"/>
        <result property="password" column="password"/>
        <result property="dateOfBirth" column="date_of_birth"/>
        <result property="bankName" column="bank_name"/>
        <result property="status" column="status"/>
        <result property="branchId" column="branch_id"/>
        <result property="nomineeName" column="nominee_name"/>
        <result property="nomineeRelationship" column="nominee_relationship"/>
        <result property="nomineePhoneNumber" column="nominee_phone_number"/>
    </resultMap>

    <insert id="insertCustomer" parameterType="com.crimsonlogic.bankingandloanmanagementsystem.model.implementations.userimplementations.Customer">
        INSERT INTO customers (customer_id, name, phone_number, email, address, password, date_of_birth, bank_name, status, branch_id, nominee_name, nominee_relationship, nominee_phone_number)
        VALUES (#{customerId}, #{name}, #{phoneNumber}, #{email}, #{address}, #{password}, #{dateOfBirth}, #{bankName}, #{status}, #{branchId}, #{nomineeName}, #{nomineeRelationship}, #{nomineePhoneNumber})
    </insert>

    <select id="getCustomerByEmail" resultMap="CustomerResultMap">
        SELECT * FROM customers WHERE email = #{email}
    </select>

    <select id="getCustomerById" resultMap="CustomerResultMap">
        SELECT * FROM customers WHERE customer_id = #{customerId}
    </select>

    <select id="getAllCustomers" resultMap="CustomerResultMap">
        SELECT * FROM customers
    </select>

    <select id="getCustomersByBranchId" resultMap="CustomerResultMap">
        SELECT * FROM customers WHERE branch_id = #{branchId}
    </select>

    <update id="updateCustomerStatus">
        UPDATE customers SET status = #{status} WHERE customer_id = #{customerId}
    </update>

    <update id="updateCustomerPhone">
        UPDATE customers SET phone_number = #{phoneNumber} WHERE customer_id = #{customerId}
    </update>

    <update id="updateCustomerAddress">
        UPDATE customers SET address = #{address} WHERE customer_id = #{customerId}
    </update>

    <update id="updateCustomerNominee">
        UPDATE customers 
        SET nominee_name = #{nomineeName}, 
            nominee_relationship = #{nomineeRelationship}, 
            nominee_phone_number = #{nomineePhoneNumber} 
        WHERE customer_id = #{customerId}
    </update>

    <update id="updateCustomerPassword">
        UPDATE customers SET password = #{password} WHERE customer_id = #{customerId}
    </update>

</mapper>